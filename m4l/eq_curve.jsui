// eq_curve.jsui — frequency-response visualisation for namtone~ (BasicNamToneStack).
//
// Receives a 3-element list (bass, mid, treble) from namtone~ outlet 1
// (each in 0..10, matching live.dial range). Draws the exact biquad magnitude
// response using the same Audio EQ Cookbook formulas as ToneStack.cpp:
//
//   Bass:   Low shelf,  f0 = 150 Hz,  Q = 0.707, ±20 dB  (4 dB per knob step)
//   Mid:    Peaking,    f0 = 425 Hz,  Q = 0.7/1.5 (boost/cut), ±15 dB
//   Treble: High shelf, f0 = 1800 Hz, Q = 0.707, ±10 dB  (2 dB per knob step)
//
// All three at knob position 5 = 0 dB (flat).
// Coefficients are computed once per redraw. Sample rate hardcoded to 48000 Hz
// (shelf shape is stable across 44.1/48 kHz for these frequencies).

inlets = 1;
outlets = 1;

mgraphics.init();
mgraphics.relative_coords = 0;
mgraphics.autofill = 0;

var bass   = 5.0;
var mid    = 5.0;
var treble = 5.0;

var FMIN        = 20.0;
var FMAX        = 20000.0;
var N_POINTS    = 128;
var SAMPLE_RATE = 48000.0;
var DB_CLIP     = 24.0;  // ±24 dB display range (bass goes ±20 dB)

// ── messages ─────────────────────────────────────────────────────────────────

function list(b, m, t) {
    if (arguments.length >= 1) bass   = +b;
    if (arguments.length >= 2) mid    = +m;
    if (arguments.length >= 3) treble = +t;
    mgraphics.redraw();
}

function bang() { mgraphics.redraw(); }

// ── biquad coefficient helpers (mirror ToneStack.cpp) ────────────────────────

function lowShelfCoeffs(gainDB) {
    var f0 = 150.0, Q = 0.707;
    var a  = Math.pow(10.0, gainDB / 40.0);
    var w0 = 2.0 * Math.PI * f0 / SAMPLE_RATE;
    var al = Math.sin(w0) / (2.0 * Q);
    var cw = Math.cos(w0);
    var ap = a + 1.0, am = a - 1.0;
    var r  = 2.0 * Math.sqrt(a) * al;
    return [
        a * (ap - am * cw + r),    // b0
        2.0 * a * (am - ap * cw),  // b1
        a * (ap - am * cw - r),    // b2
        ap + am * cw + r,           // a0
        -2.0 * (am + ap * cw),     // a1
        ap + am * cw - r            // a2
    ];
}

function peakingCoeffs(gainDB) {
    var f0 = 425.0, Q = (gainDB < 0.0) ? 1.5 : 0.7;
    var a  = Math.pow(10.0, gainDB / 40.0);
    var w0 = 2.0 * Math.PI * f0 / SAMPLE_RATE;
    var al = Math.sin(w0) / (2.0 * Q);
    var cw = Math.cos(w0);
    return [
        1.0 + al * a,   // b0
        -2.0 * cw,      // b1
        1.0 - al * a,   // b2
        1.0 + al / a,   // a0
        -2.0 * cw,      // a1
        1.0 - al / a    // a2
    ];
}

function highShelfCoeffs(gainDB) {
    var f0 = 1800.0, Q = 0.707;
    var a  = Math.pow(10.0, gainDB / 40.0);
    var w0 = 2.0 * Math.PI * f0 / SAMPLE_RATE;
    var al = Math.sin(w0) / (2.0 * Q);
    var cw = Math.cos(w0);
    var ap = a + 1.0, am = a - 1.0;
    var r  = 2.0 * Math.sqrt(a) * al;
    return [
        a * (ap + am * cw + r),    // b0
        -2.0 * a * (am + ap * cw), // b1
        a * (ap + am * cw - r),    // b2
        ap - am * cw + r,           // a0
        2.0 * (am - ap * cw),      // a1
        ap - am * cw - r            // a2
    ];
}

// |H(e^jω)|² in dB for one biquad, given precomputed coefficients array
// c = [b0, b1, b2, a0, a1, a2].
function biquadMagDB(omega, c) {
    var cw  = Math.cos(omega),  sw  = Math.sin(omega);
    var c2w = Math.cos(2.0 * omega), s2w = Math.sin(2.0 * omega);

    var nr = c[0] + c[1] * cw  + c[2] * c2w;
    var ni = -(c[1] * sw + c[2] * s2w);
    var dr = c[3] + c[4] * cw  + c[5] * c2w;
    var di = -(c[4] * sw + c[5] * s2w);

    var num2 = nr * nr + ni * ni;
    var den2 = dr * dr + di * di;
    if (den2 < 1e-30) return 0.0;
    return 10.0 * Math.log(num2 / den2) / Math.LN10;
}

// ── paint ─────────────────────────────────────────────────────────────────────

function paint() {
    var width  = box.rect[2] - box.rect[0];
    var height = box.rect[3] - box.rect[1];

    // Precompute coefficients once per frame.
    var bassC   = lowShelfCoeffs(4.0 * (bass   - 5.0));
    var midC    = peakingCoeffs( 3.0 * (mid    - 5.0));
    var trebleC = highShelfCoeffs(2.0 * (treble - 5.0));

    var log_min = Math.log(FMIN);
    var log_max = Math.log(FMAX);

    with (mgraphics) {
        set_source_rgba(0.18, 0.18, 0.20, 1.0);
        rectangle(0, 0, width, height);
        fill();

        // Zero-dB midline.
        set_source_rgba(1.0, 1.0, 1.0, 0.20);
        set_line_width(1.0);
        move_to(0, height / 2);
        line_to(width, height / 2);
        stroke();

        // Magnitude curve.
        set_source_rgba(1.0, 0.68, 0.0, 1.0);
        set_line_width(1.5);

        var first = true;
        for (var i = 0; i < N_POINTS; ++i) {
            var x_frac = i / (N_POINTS - 1);
            var f      = Math.exp(log_min + x_frac * (log_max - log_min));
            var omega  = 2.0 * Math.PI * f / SAMPLE_RATE;
            var db     = biquadMagDB(omega, bassC)
                       + biquadMagDB(omega, midC)
                       + biquadMagDB(omega, trebleC);

            if (db >  DB_CLIP) db =  DB_CLIP;
            if (db < -DB_CLIP) db = -DB_CLIP;

            var x = x_frac * width;
            var y = height / 2 - (db / DB_CLIP) * (height / 2 - 4);

            if (first) { move_to(x, y); first = false; }
            else        { line_to(x, y); }
        }
        stroke();
    }
}

function loadbang() { mgraphics.redraw(); }
